aws_region          = "eu-west-3"
ecr_repository_name = "abstergo/signaling"
image_tag           = "latest"

ecs_cluster_name       = "abstergo-signaling-cluster"
ecs_service_name       = "abstergo-signaling-service"
task_definition_family = "abstergo-signaling-task"

task_cpu               = 256
task_memory            = 512
container_port         = 5174
socket_io_path         = "/socket.io"
memory_only_mode       = true
empty_game_ttl_ms      = 300000
turn_urls              = "stun:35.181.228.185:3478,turn:35.181.228.185:3478?transport=udp,turn:35.181.228.185:3478?transport=tcp"
turn_secret            = "CHANGE_ME_WITH_THE_SAME_SECRET_AS_VOICE_TURN"
turn_realm             = "voice.abstergochase"
turn_ttl_seconds       = 600
desired_count          = 1
assign_public_ip       = true
task_security_group_id = "sg-xxxxxxxxxxxxxxxxx"

nlb_name                 = "abstergo-signaling-nlb-1eip"
signaling_listener_port  = 80
# Same AZ as the ECS tasks (mono-AZ NLB).
nlb_subnet_id            = "subnet-xxxxxxxx"
turn_backend_instance_id = "i-xxxxxxxxxxxxxxxxx"

subnet_ids = [
  "subnet-xxxxxxxx"
]

security_group_ids = [
  "sg-xxxxxxxxxxxxxxxxx"
]

common_tags = {
  Project     = "Broken Veil Protocol"
  Environment = "dev"
  ManagedBy   = "opentofu"
  Owner       = "alexandre"
  Stack       = "ecs-signaling"
}

name_tag_prefix = "broken-veil-protocol-signaling"
vpc_name_tag    = "broken-veil-protocol-shared-vpc"
