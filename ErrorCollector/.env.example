NODE_ENV=development
PORT=5180
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=abstergo_errors
DATABASE_USER=abstergo_errors
DATABASE_PASSWORD=replace-with-your-database-password
DATABASE_SSL=false
# Only needed for local Docker; do not reuse the database user password.
ERRORS_DB_ROOT_PASSWORD=replace-with-a-separate-local-root-password
# Same Cognito pool and app client as the mobile application.
COGNITO_ISSUER=https://cognito-idp.eu-west-3.amazonaws.com/REPLACE_WITH_POOL_ID
COGNITO_CLIENT_ID=replace-with-app-client-id
# Generate a long random token. This token belongs on the server ONLY.
ERROR_ADMIN_TOKEN=replace-with-at-least-32-random-characters
# o2switch terminates HTTPS in front of Node through Passenger.
TRUST_PROXY=1
# If deployed under a domain path, for example /abstergo-errors.
APP_BASE_PATH=

# Applications Node.js o2switch
PASSENGER=false
DIAGNOSTICS_SERVER_TOKEN=
DIAGNOSTICS_MAX_BYTES=0
